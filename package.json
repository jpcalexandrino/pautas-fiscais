{
  "name": "pricer",
  "private": true,
  "version": "0.0.0",
  "description": "Monorepo Pricer — client (Vite/React) + server (Express/API)",
  "scripts": {
    "dev": "npm run dev --prefix client",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "server": "npm run dev --prefix server",
    "build": "npm run build --prefix client",
    "build:client": "npm run build --prefix client",
    "build:server": "npm run build --prefix server",
    "build:all": "npm run build:client && npm run build:server",
    "start": "npm start --prefix server",
    "deploy:homolog": "bash scripts/deploy-homolog.sh",
    "pm2:homolog": "pm2 start ecosystem.config.cjs --only pricer-homolog",
    "pm2:prod": "pm2 start ecosystem.config.cjs --only pricer",
    "lint": "npm run lint --prefix client",
    "preview": "npm run preview --prefix client",
    "type-check": "npm run type-check --prefix client"
  }
}
